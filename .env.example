# TransCreate Environment Configuration
# Copy this file to .env and fill in your Google AI Studio API key
 
# Get a free key at: https://aistudio.google.com/apikey
# No credit card required — free tier supports Gemma 4
VITE_GEMINI_API_KEY=

# Model selection — default is gemma-4-27b-it (most capable, use gemma-4-9b-it for faster responses)
VITE_GEMMA_MODEL=gemma-4-27b-it

# If left empty, the app will run in Demo Mode with realistic mock responses
